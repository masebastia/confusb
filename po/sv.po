#: confusb/kb.py:35
msgid ""
"pcsc_scan shows in real time when a card is inserted or removed and decodes "
"its ATR."
msgstr ""
"pcsc_scan visar i realtid när ett kort sätts i eller tas bort och avkodar "
"dess ATR."

#: confusb/kb.py:37
msgid "Open pcsc_scan"
msgstr "Öppna pcsc_scan"

#: confusb/kb.py:40
