#: confusb/kb.py:17
msgid "PC/SC service and CCID drivers"
msgstr "Služba PC/SC a ovladače CCID"

#: confusb/kb.py:18
msgid ""
"pcscd is the daemon that manages smart card readers; libccid provides the "
"driver for standard USB readers (CCID). Without pcscd the reader shows up in "
"USB but no application can use it."
msgstr ""
"pcscd je démon, který spravuje čtečky čipových karet; libccid poskytuje "
"ovladač pro standardní čtečky USB (CCID). Bez pcscd se čtečka zobrazí v USB, "
"ale žádná aplikace ji nemůže používat."

#: confusb/kb.py:22
msgid "OpenSC (PKCS#11, supports DNIe and other cards)"
msgstr "OpenSC (PKCS#11, podporuje DNIe a další karty)"

#: confusb/kb.py:23
msgid ""
"Library and tools for cryptographic cards. It includes support for the DNIe "
"(3.0/4.0) and the PKCS#11 module used by Firefox/Chromium and AutoFirma. "
"Older DNIe cards (2.0) may need the official DNIe module."
msgstr ""
"Knihovna a nástroje pro kryptografické karty. Zahrnuje podporu DNIe "
"(3.0/4.0) a modul PKCS#11, který používají Firefox/Chromium a AutoFirma. "
"Starší DNIe (2.0) mohou vyžadovat oficiální modul DNIe."

#: confusb/kb.py:26
msgid "List readers"
msgstr "Vypsat čtečky"

#: confusb/kb.py:27
msgid "Card info (ATR)"
msgstr "Informace o kartě (ATR)"

#: confusb/kb.py:28
msgid "List PKCS#11 slots"
msgstr "Vypsat sloty PKCS#11"

#: confusb/kb.py:29
msgid "List certificates"
msgstr "Vypsat certifikáty"

#: confusb/kb.py:34
msgid "pcsc-tools (reader and card monitor)"
msgstr "pcsc-tools (monitor čteček a karet)"

#: confusb/kb.py:35
msgid ""
"pcsc_scan shows in real time when a card is inserted or removed and decodes "
"its ATR."
msgstr ""
"pcsc_scan v reálném čase ukazuje vložení nebo vyjmutí karty a dekóduje její "
"ATR."

#: confusb/kb.py:37
msgid "Open pcsc_scan"
msgstr "Otevřít pcsc_scan"

#: confusb/kb.py:40
