#: confusb/kb.py:34
msgid "pcsc-tools (reader and card monitor)"
msgstr "pcsc-tools (okuyucu ve kart izleyicisi)"

#: confusb/kb.py:35
msgid ""
"pcsc_scan shows in real time when a card is inserted or removed and decodes "
"its ATR."
msgstr ""
"pcsc_scan, bir kart takıldığında veya çıkarıldığında gerçek zamanlı gösterir "
"ve ATR'sini çözer."

#: confusb/kb.py:37
