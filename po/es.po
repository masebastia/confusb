#: confusb/kb.py:17
msgid "PC/SC service and CCID drivers"
msgstr "Servicio PC/SC y controladores CCID"

#: confusb/kb.py:18
msgid ""
"pcscd is the daemon that manages smart card readers; libccid provides the "
"driver for standard USB readers (CCID). Without pcscd the reader shows up in "
"USB but no application can use it."
msgstr ""
"pcscd es el demonio que gestiona los lectores de tarjetas; libccid trae el "
"controlador para lectores USB estándar (CCID). Sin pcscd el lector se ve en "
"USB pero ninguna aplicación puede usarlo."

#: confusb/kb.py:22
msgid "OpenSC (PKCS#11, supports DNIe and other cards)"
msgstr "OpenSC (PKCS#11, soporta DNIe y otras tarjetas)"

#: confusb/kb.py:23
msgid ""
"Library and tools for cryptographic cards. It includes support for the DNIe "
"(3.0/4.0) and the PKCS#11 module used by Firefox/Chromium and AutoFirma. "
"Older DNIe cards (2.0) may need the official DNIe module."
msgstr ""
"Librería y herramientas para tarjetas criptográficas. Incluye soporte del "
"DNIe (3.0/4.0) y el módulo PKCS#11 que usan Firefox/Chromium y AutoFirma. "
"Para DNIe antiguos (2.0) puede hacer falta el módulo oficial del DNIe."

#: confusb/kb.py:26
msgid "List readers"
msgstr "Listar lectores"

#: confusb/kb.py:27
msgid "Card info (ATR)"
msgstr "Info de la tarjeta (ATR)"

#: confusb/kb.py:28
msgid "List PKCS#11 slots"
msgstr "Listar slots PKCS#11"

#: confusb/kb.py:29
msgid "List certificates"
msgstr "Listar certificados"

#: confusb/kb.py:34
msgid "pcsc-tools (reader and card monitor)"
msgstr "pcsc-tools (monitor de lectores y tarjetas)"

#: confusb/kb.py:35
msgid ""
"pcsc_scan shows in real time when a card is inserted or removed and decodes "
"its ATR."
msgstr ""
"pcsc_scan muestra en tiempo real cuándo se inserta/retira una tarjeta y "
"decodifica su ATR."

#: confusb/kb.py:37
msgid "Open pcsc_scan"
msgstr "Abrir pcsc_scan"

#: confusb/kb.py:40
msgid "AutoFirma (electronic signature)"
msgstr "AutoFirma (firma electrónica)"

#: confusb/kb.py:41
msgid ""
"Official Spanish Government application to sign documents with the DNIe or a "
"digital certificate. It is not in the Debian repositories: it is downloaded "
"from firmaelectronica.gob.es."
msgstr ""
"Aplicación oficial del Gobierno para firmar documentos con el DNIe o un "
"certificado digital. No está en los repositorios de Debian: se descarga de "
"firmaelectronica.gob.es."

