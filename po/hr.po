msgstr "Prikaži certifikate"

#: confusb/kb.py:34
msgid "pcsc-tools (reader and card monitor)"
msgstr "pcsc-tools (nadzor čitača i kartica)"

#: confusb/kb.py:35
msgid ""
"pcsc_scan shows in real time when a card is inserted or removed and decodes "
"its ATR."
msgstr ""
"pcsc_scan u stvarnom vremenu prikazuje umetanje ili vađenje kartice i "
"dekodira njezin ATR."

#: confusb/kb.py:37
msgid "Open pcsc_scan"
