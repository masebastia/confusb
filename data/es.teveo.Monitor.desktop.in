[Desktop Entry]
Type=Application
Name=teveo
GenericName=Dispositivos USB
Comment=Información, controladores y aplicaciones de los dispositivos USB conectados
Exec=/usr/bin/python3 -m teveo --devices
Path=@PROJECT_DIR@
Icon=es.teveo.Monitor
Terminal=false
Categories=System;Monitor;
Keywords=usb;dispositivo;controlador;driver;lector;
StartupWMClass=es.teveo.Monitor
StartupNotify=true
