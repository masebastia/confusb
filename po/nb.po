#: confusb/configuracion.py:318
#, python-brace-format
msgid ""
"It has a manufacturer-specific HID channel ({n} feature or output reports, "
"up to {size} bytes). The software of gaming mice usually uses it for "
"settings such as DPI, buttons and lighting."
msgstr "Den har en produsentspesifikk HID-kanal ({n} feature- eller output-rapporter, opptil {size} byte). Programvaren til gamingmus bruker den vanligvis til innstillinger som DPI, knapper og belysning."

