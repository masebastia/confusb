#, python-brace-format
msgid "It may be configurable with {tool}, a tool for {brand} devices."
msgstr "Магчыма, яго можна наладзіць з дапамогай {tool} — інструмента для прылад {brand}."

#: confusb/configuracion.py:331
msgid "A game controller can be remapped with input-remapper."
msgstr "Гульнявы кантролер можна перапрызначыць з дапамогай input-remapper."

