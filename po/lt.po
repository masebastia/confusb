#: confusb/kb.py:35
msgid ""
"pcsc_scan shows in real time when a card is inserted or removed and decodes "
"its ATR."
msgstr ""
"pcsc_scan realiuoju laiku rodo, kada kortelė įdedama ar išimama, ir "
"iššifruoja jos ATR."

#: confusb/kb.py:37
msgid "Open pcsc_scan"
