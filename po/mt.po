#: confusb/kb.py:17
msgid "PC/SC service and CCID drivers"
msgstr "Servizz PC/SC u drivers CCID"

#: confusb/kb.py:18
msgid ""
"pcscd is the daemon that manages smart card readers; libccid provides the "
"driver for standard USB readers (CCID). Without pcscd the reader shows up in "
"USB but no application can use it."
msgstr ""
"pcscd huwa d-demon li jimmaniġġja l-qarrejja tal-karti intelliġenti; libccid "
"jipprovdi d-driver għall-qarrejja USB standard (CCID). Mingħajr pcscd il-"
"qarrej jidher fl-USB iżda ebda applikazzjoni ma tista' tużah."

#: confusb/kb.py:22
msgid "OpenSC (PKCS#11, supports DNIe and other cards)"
msgstr "OpenSC (PKCS#11, jappoġġja d-DNIe u karti oħra)"

#: confusb/kb.py:23
msgid ""
"Library and tools for cryptographic cards. It includes support for the DNIe "
"(3.0/4.0) and the PKCS#11 module used by Firefox/Chromium and AutoFirma. "
"Older DNIe cards (2.0) may need the official DNIe module."
msgstr ""
"Librerija u għodod għal karti kriptografiċi. Tinkludi appoġġ għad-DNIe "
"(3.0/4.0) u l-modulu PKCS#11 użat minn Firefox/Chromium u AutoFirma. Id-DNIe "
"eqdem (2.0) jistgħu jeħtieġu l-modulu uffiċjali tad-DNIe."

#: confusb/kb.py:26
msgid "List readers"
msgstr "Elenka l-qarrejja"

#: confusb/kb.py:27
msgid "Card info (ATR)"
msgstr "Informazzjoni tal-karta (ATR)"

#: confusb/kb.py:28
msgid "List PKCS#11 slots"
msgstr "Elenka l-islots PKCS#11"

#: confusb/kb.py:29
msgid "List certificates"
msgstr "Elenka ċ-ċertifikati"

#: confusb/kb.py:34
msgid "pcsc-tools (reader and card monitor)"
msgstr "pcsc-tools (monitor tal-qarrejja u l-karti)"

#: confusb/kb.py:35
msgid ""
"pcsc_scan shows in real time when a card is inserted or removed and decodes "
"its ATR."
msgstr ""
"pcsc_scan juri f'ħin reali meta karta tiddaħħal jew titneħħa u jiddekodifika "
"l-ATR tagħha."

#: confusb/kb.py:37
msgid "Open pcsc_scan"
msgstr "Iftaħ pcsc_scan"

#: confusb/kb.py:40
msgid "AutoFirma (electronic signature)"
msgstr "AutoFirma (firma elettronika)"

#: confusb/kb.py:41
msgid ""
"Official Spanish Government application to sign documents with the DNIe or a "
"digital certificate. It is not in the Debian repositories: it is downloaded "
"from firmaelectronica.gob.es."
msgstr ""
"Applikazzjoni uffiċjali tal-Gvern Spanjol biex jiffirmaw dokumenti bid-DNIe "
"jew b'ċertifikat diġitali. Mhix fir-repożitorji ta' Debian: titniżżel minn "
"firmaelectronica.gob.es."

