#: confusb/kb.py:17
msgid "PC/SC service and CCID drivers"
msgstr "PC/SC-tjeneste og CCID-drivere"

#: confusb/kb.py:18
msgid ""
"pcscd is the daemon that manages smart card readers; libccid provides the "
"driver for standard USB readers (CCID). Without pcscd the reader shows up in "
"USB but no application can use it."
msgstr ""
"pcscd er daemonen som styrer smartkortlesere; libccid gir driveren for "
"vanlige USB-lesere (CCID). Uten pcscd vises leseren i USB, men ingen "
"programmer kan bruke den."

#: confusb/kb.py:22
msgid "OpenSC (PKCS#11, supports DNIe and other cards)"
msgstr "OpenSC (PKCS#11, støtter DNIe og andre kort)"

#: confusb/kb.py:23
msgid ""
"Library and tools for cryptographic cards. It includes support for the DNIe "
"(3.0/4.0) and the PKCS#11 module used by Firefox/Chromium and AutoFirma. "
"Older DNIe cards (2.0) may need the official DNIe module."
msgstr ""
"Bibliotek og verktøy for kryptografiske kort. Inkluderer støtte for DNIe "
"(3.0/4.0) og PKCS#11-modulen som Firefox/Chromium og AutoFirma bruker. Eldre "
"DNIe (2.0) kan trenge den offisielle DNIe-modulen."

#: confusb/kb.py:26
msgid "List readers"
msgstr "Vis lesere"

#: confusb/kb.py:27
msgid "Card info (ATR)"
msgstr "Kortinformasjon (ATR)"

#: confusb/kb.py:28
msgid "List PKCS#11 slots"
msgstr "Vis PKCS#11-spor"

#: confusb/kb.py:29
msgid "List certificates"
msgstr "Vis sertifikater"

#: confusb/kb.py:34
msgid "pcsc-tools (reader and card monitor)"
msgstr "pcsc-tools (overvåker for lesere og kort)"

#: confusb/kb.py:35
msgid ""
"pcsc_scan shows in real time when a card is inserted or removed and decodes "
"its ATR."
msgstr ""
"pcsc_scan viser i sanntid når et kort settes inn eller fjernes, og dekoder "
"ATR-en."

#: confusb/kb.py:37
msgid "Open pcsc_scan"
msgstr "Åpne pcsc_scan"

#: confusb/kb.py:40
msgid "AutoFirma (electronic signature)"
msgstr "AutoFirma (elektronisk signatur)"

#: confusb/kb.py:41
msgid ""
"Official Spanish Government application to sign documents with the DNIe or a "
"digital certificate. It is not in the Debian repositories: it is downloaded "
"from firmaelectronica.gob.es."
msgstr ""
"Den spanske regjeringens offisielle program for å signere dokumenter med "
"DNIe eller et digitalt sertifikat. Det finnes ikke i Debians pakkekilder: "
"det lastes ned fra firmaelectronica.gob.es."

