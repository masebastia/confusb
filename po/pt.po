msgstr ""
"O pcsc_scan mostra em tempo real quando um cartão é inserido ou removido e "
"descodifica o seu ATR."

#: confusb/kb.py:37
msgid "Open pcsc_scan"
msgstr "Abrir o pcsc_scan"

