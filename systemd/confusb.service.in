[Unit]
Description=confusb - aviso e información al conectar dispositivos USB
After=graphical-session.target
PartOf=graphical-session.target

[Service]
ExecStart=/usr/bin/python3 -m confusb
WorkingDirectory=@PROJECT_DIR@
# Las ventanas que lanza el servicio son procesos suyos: reiniciarlo no debe cerrarlas.
KillMode=process
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
