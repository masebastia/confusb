[Desktop Entry]
Type=Application
Name=confusb
GenericName=Dispositivos USB
Comment=Información, controladores y aplicaciones de los dispositivos USB conectados
Exec=/usr/bin/python3 -m confusb --devices
Path=@PROJECT_DIR@
Icon=es.masebastia.confusb
Terminal=false
Categories=System;Monitor;
Keywords=usb;dispositivo;controlador;driver;lector;
StartupWMClass=es.masebastia.confusb
StartupNotify=true
