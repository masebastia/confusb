msgid "List PKCS#11 slots"
msgstr "PKCS#11 foglalatok listázása"

#: confusb/kb.py:29
msgid "List certificates"
msgstr "Tanúsítványok listázása"

#: confusb/kb.py:34
msgid "pcsc-tools (reader and card monitor)"
msgstr "pcsc-tools (olvasó- és kártyafigyelő)"

#: confusb/kb.py:35
msgid "pcsc_scan shows in real time when a card is inserted or removed and decodes its ATR."
msgstr "A pcsc_scan valós időben mutatja, mikor helyeznek be vagy távolítanak el egy kártyát, és dekódolja az ATR-jét."

#: confusb/kb.py:37
msgid "Open pcsc_scan"
msgstr "A pcsc_scan megnyitása"

#: confusb/kb.py:40
msgid "AutoFirma (electronic signature)"
msgstr "AutoFirma (elektronikus aláírás)"

#: confusb/kb.py:41
msgid "Official Spanish Government application to sign documents with the DNIe or a digital certificate. It is not in the Debian repositories: it is downloaded from firmaelectronica.gob.es."
msgstr "A spanyol kormány hivatalos alkalmazása dokumentumok aláírására DNIe-vel vagy digitális tanúsítvánnyal. Nincs benne a Debian tárolóiban: a firmaelectronica.gob.es oldalról tölthető le."

#: confusb/kb.py:48 confusb/usbinfo.py:23
msgid "Mass storage"
msgstr "Háttértár"

#: confusb/kb.py:48
msgid "The system mounts it automatically (udisks2). To format or inspect it, use Disks."
