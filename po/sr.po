msgid "List PKCS#11 slots"
msgstr "Прикажи PKCS#11 слотове"

#: confusb/kb.py:29
msgid "List certificates"
msgstr "Прикажи сертификате"

#: confusb/kb.py:34
msgid "pcsc-tools (reader and card monitor)"
msgstr "pcsc-tools (надзор читача и картица)"

#: confusb/kb.py:35
msgid "pcsc_scan shows in real time when a card is inserted or removed and decodes its ATR."
msgstr "pcsc_scan у реалном времену приказује када се картица умеће или вади и декодира њен ATR."

#: confusb/kb.py:37
msgid "Open pcsc_scan"
msgstr "Отвори pcsc_scan"

#: confusb/kb.py:40
msgid "AutoFirma (electronic signature)"
msgstr "AutoFirma (електронски потпис)"

#: confusb/kb.py:41
msgid "Official Spanish Government application to sign documents with the DNIe or a digital certificate. It is not in the Debian repositories: it is downloaded from firmaelectronica.gob.es."
msgstr "Званична апликација шпанске владе за потписивање докумената помоћу DNIe-а или дигиталног сертификата. Није у Debian репозиторијумима: преузима се са firmaelectronica.gob.es."

