#: confusb/componentes.py:573
msgid ""
"Notifies when a USB device is connected, shows its information and looks for "
"its driver and the applications to use it."
msgstr ""
"Njofton kur lidhet një pajisje USB, shfaq informacionin e saj dhe kërkon "
"drajverin dhe aplikacionet për ta përdorur."

