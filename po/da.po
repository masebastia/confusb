msgstr "pcsc-tools (monitor for læsere og kort)"

#: confusb/kb.py:35
msgid ""
"pcsc_scan shows in real time when a card is inserted or removed and decodes "
"its ATR."
msgstr ""
"pcsc_scan viser i realtid, når et kort sættes i eller fjernes, og afkoder "
"dets ATR."

#: confusb/kb.py:37
msgid "Open pcsc_scan"
msgstr "Åbn pcsc_scan"

#: confusb/kb.py:40
