#: confusb/kb.py:17
msgid "PC/SC service and CCID drivers"
msgstr "PC/SC-tjeneste og CCID-drivere"

#: confusb/kb.py:18
msgid ""
"pcscd is the daemon that manages smart card readers; libccid provides the "
"driver for standard USB readers (CCID). Without pcscd the reader shows up in "
"USB but no application can use it."
msgstr ""
"pcscd er den dæmon, der styrer smartcard-læsere; libccid leverer driveren "
"til standard-USB-læsere (CCID). Uden pcscd vises læseren i USB, men intet "
"program kan bruge den."

#: confusb/kb.py:22
msgid "OpenSC (PKCS#11, supports DNIe and other cards)"
msgstr "OpenSC (PKCS#11, understøtter DNIe og andre kort)"

#: confusb/kb.py:23
msgid ""
"Library and tools for cryptographic cards. It includes support for the DNIe "
"(3.0/4.0) and the PKCS#11 module used by Firefox/Chromium and AutoFirma. "
"Older DNIe cards (2.0) may need the official DNIe module."
msgstr ""
"Bibliotek og værktøjer til kryptografiske kort. Omfatter understøttelse af "
"DNIe (3.0/4.0) og det PKCS#11-modul, som Firefox/Chromium og AutoFirma "
"bruger. Ældre DNIe (2.0) kan kræve det officielle DNIe-modul."

#: confusb/kb.py:26
msgid "List readers"
msgstr "Vis læsere"

#: confusb/kb.py:27
msgid "Card info (ATR)"
msgstr "Kortoplysninger (ATR)"

#: confusb/kb.py:28
msgid "List PKCS#11 slots"
msgstr "Vis PKCS#11-slots"

#: confusb/kb.py:29
msgid "List certificates"
msgstr "Vis certifikater"

#: confusb/kb.py:34
