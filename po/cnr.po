#: confusb/kb.py:17
msgid "PC/SC service and CCID drivers"
msgstr "Usluga PC/SC i CCID upravljački programi"

#: confusb/kb.py:18
msgid "pcscd is the daemon that manages smart card readers; libccid provides the driver for standard USB readers (CCID). Without pcscd the reader shows up in USB but no application can use it."
msgstr "pcscd je daemon koji upravlja čitačima pametnih kartica; libccid pruža upravljački program za standardne USB čitače (CCID). Bez pcscd-a čitač se pojavljuje u USB-u, ali ga nijedna aplikacija ne može koristiti."

#: confusb/kb.py:22
msgid "OpenSC (PKCS#11, supports DNIe and other cards)"
msgstr "OpenSC (PKCS#11, podržava DNIe i druge kartice)"

#: confusb/kb.py:23
msgid "Library and tools for cryptographic cards. It includes support for the DNIe (3.0/4.0) and the PKCS#11 module used by Firefox/Chromium and AutoFirma. Older DNIe cards (2.0) may need the official DNIe module."
msgstr "Biblioteka i alati za kriptografske kartice. Uključuje podršku za DNIe (3.0/4.0) i PKCS#11 modul koji koriste Firefox/Chromium i AutoFirma. Stariji DNIe (2.0) mogu zahtijevati službeni DNIe modul."

#: confusb/kb.py:26
msgid "List readers"
msgstr "Prikaži čitače"

#: confusb/kb.py:27
msgid "Card info (ATR)"
msgstr "Informacije o kartici (ATR)"

