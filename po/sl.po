#: confusb/kb.py:17
msgid "PC/SC service and CCID drivers"
msgstr "Storitev PC/SC in gonilniki CCID"

#: confusb/kb.py:18
msgid ""
"pcscd is the daemon that manages smart card readers; libccid provides the "
"driver for standard USB readers (CCID). Without pcscd the reader shows up in "
"USB but no application can use it."
msgstr ""
"pcscd je demon, ki upravlja bralnike pametnih kartic; libccid zagotavlja "
"gonilnik za standardne bralnike USB (CCID). Brez pcscd se bralnik prikaže v "
"USB, vendar ga noben program ne more uporabljati."

#: confusb/kb.py:22
msgid "OpenSC (PKCS#11, supports DNIe and other cards)"
msgstr "OpenSC (PKCS#11, podpira DNIe in druge kartice)"

#: confusb/kb.py:23
msgid ""
"Library and tools for cryptographic cards. It includes support for the DNIe "
"(3.0/4.0) and the PKCS#11 module used by Firefox/Chromium and AutoFirma. "
"Older DNIe cards (2.0) may need the official DNIe module."
msgstr ""
"Knjižnica in orodja za kriptografske kartice. Vključuje podporo za DNIe "
"(3.0/4.0) in modul PKCS#11, ki ga uporabljata Firefox/Chromium in AutoFirma. "
"Starejši DNIe (2.0) morda potrebujejo uradni modul DNIe."

#: confusb/kb.py:26
msgid "List readers"
msgstr "Prikaži bralnike"

#: confusb/kb.py:27
msgid "Card info (ATR)"
msgstr "Podatki o kartici (ATR)"

