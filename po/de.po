#: confusb/kb.py:17
msgid "PC/SC service and CCID drivers"
msgstr "PC/SC-Dienst und CCID-Treiber"

#: confusb/kb.py:18
msgid "pcscd is the daemon that manages smart card readers; libccid provides the driver for standard USB readers (CCID). Without pcscd the reader shows up in USB but no application can use it."
msgstr "pcscd ist der Dienst, der Chipkartenleser verwaltet; libccid liefert den Treiber für Standard-USB-Leser (CCID). Ohne pcscd erscheint der Leser in USB, aber keine Anwendung kann ihn nutzen."

#: confusb/kb.py:22
msgid "OpenSC (PKCS#11, supports DNIe and other cards)"
msgstr "OpenSC (PKCS#11, unterstützt den DNIe und andere Karten)"

#: confusb/kb.py:23
msgid "Library and tools for cryptographic cards. It includes support for the DNIe (3.0/4.0) and the PKCS#11 module used by Firefox/Chromium and AutoFirma. Older DNIe cards (2.0) may need the official DNIe module."
msgstr "Bibliothek und Werkzeuge für kryptografische Karten. Enthält Unterstützung für den DNIe (3.0/4.0) und das PKCS#11-Modul, das Firefox/Chromium und AutoFirma verwenden. Ältere DNIe (2.0) benötigen eventuell das offizielle DNIe-Modul."

#: confusb/kb.py:26
msgid "List readers"
msgstr "Leser auflisten"

#: confusb/kb.py:27
msgid "Card info (ATR)"
msgstr "Karteninfo (ATR)"

#: confusb/kb.py:28
msgid "List PKCS#11 slots"
msgstr "PKCS#11-Slots auflisten"

#: confusb/kb.py:29
msgid "List certificates"
msgstr "Zertifikate auflisten"

#: confusb/kb.py:34
msgid "pcsc-tools (reader and card monitor)"
msgstr "pcsc-tools (Leser- und Kartenmonitor)"

#: confusb/kb.py:35
msgid "pcsc_scan shows in real time when a card is inserted or removed and decodes its ATR."
msgstr "pcsc_scan zeigt in Echtzeit an, wann eine Karte eingesteckt oder entfernt wird, und dekodiert ihren ATR."

#: confusb/kb.py:37
msgid "Open pcsc_scan"
msgstr "pcsc_scan öffnen"

#: confusb/kb.py:40
msgid "AutoFirma (electronic signature)"
msgstr "AutoFirma (elektronische Signatur)"

