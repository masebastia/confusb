#: confusb/kb.py:17
msgid "PC/SC service and CCID drivers"
msgstr "Shërbimi PC/SC dhe drajverat CCID"

#: confusb/kb.py:18
msgid ""
"pcscd is the daemon that manages smart card readers; libccid provides the "
"driver for standard USB readers (CCID). Without pcscd the reader shows up in "
"USB but no application can use it."
msgstr ""
"pcscd është demoni që menaxhon lexuesit e kartave inteligjente; libccid "
"ofron drajverin për lexuesit standardë USB (CCID). Pa pcscd lexuesi shfaqet "
"në USB, por asnjë aplikacion nuk mund ta përdorë."

#: confusb/kb.py:22
msgid "OpenSC (PKCS#11, supports DNIe and other cards)"
msgstr "OpenSC (PKCS#11, mbështet DNIe dhe karta të tjera)"

#: confusb/kb.py:23
msgid ""
"Library and tools for cryptographic cards. It includes support for the DNIe "
"(3.0/4.0) and the PKCS#11 module used by Firefox/Chromium and AutoFirma. "
"Older DNIe cards (2.0) may need the official DNIe module."
msgstr ""
"Bibliotekë dhe mjete për karta kriptografike. Përfshin mbështetjen për DNIe "
"(3.0/4.0) dhe modulin PKCS#11 që përdorin Firefox/Chromium dhe AutoFirma. "
"DNIe-të e vjetra (2.0) mund të kenë nevojë për modulin zyrtar të DNIe."

#: confusb/kb.py:26
msgid "List readers"
msgstr "Listo lexuesit"

#: confusb/kb.py:27
msgid "Card info (ATR)"
msgstr "Informacione të kartës (ATR)"

#: confusb/kb.py:28
msgid "List PKCS#11 slots"
msgstr "Listo folezat PKCS#11"

#: confusb/kb.py:29
msgid "List certificates"
msgstr "Listo certifikatat"

#: confusb/kb.py:34
msgid "pcsc-tools (reader and card monitor)"
msgstr "pcsc-tools (monitor i lexuesve dhe kartave)"

#: confusb/kb.py:35
msgid ""
"pcsc_scan shows in real time when a card is inserted or removed and decodes "
"its ATR."
msgstr ""
"pcsc_scan tregon në kohë reale kur futet ose hiqet një kartë dhe dekodon ATR-"
"në e saj."

#: confusb/kb.py:37
msgid "Open pcsc_scan"
msgstr "Hap pcsc_scan"

#: confusb/kb.py:40
msgid "AutoFirma (electronic signature)"
msgstr "AutoFirma (nënshkrim elektronik)"

#: confusb/kb.py:41
msgid ""
"Official Spanish Government application to sign documents with the DNIe or a "
"digital certificate. It is not in the Debian repositories: it is downloaded "
"from firmaelectronica.gob.es."
msgstr ""
"Aplikacioni zyrtar i qeverisë spanjolle për nënshkrimin e dokumenteve me "
"DNIe ose certifikatë dixhitale. Nuk është në depot e Debian: shkarkohet nga "
"firmaelectronica.gob.es."

#: confusb/kb.py:48 confusb/usbinfo.py:24
msgid "Mass storage"
msgstr "Ruajtje masive"

#: confusb/kb.py:48
msgid ""
"The system mounts it automatically (udisks2). To format or inspect it, use "
