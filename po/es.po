msgstr "pcsc-tools (monitor de lectores y tarjetas)"

#: confusb/kb.py:35
msgid ""
"pcsc_scan shows in real time when a card is inserted or removed and decodes "
"its ATR."
msgstr ""
"pcsc_scan muestra en tiempo real cuándo se inserta/retira una tarjeta y "
"decodifica su ATR."

#: confusb/kb.py:37
msgid "Open pcsc_scan"
msgstr "Abrir pcsc_scan"

#: confusb/kb.py:40
msgid "AutoFirma (electronic signature)"
msgstr "AutoFirma (firma electrónica)"

#: confusb/kb.py:41
msgid ""
"Official Spanish Government application to sign documents with the DNIe or a "
"digital certificate. It is not in the Debian repositories: it is downloaded "
"from firmaelectronica.gob.es."
msgstr ""
"Aplicación oficial del Gobierno para firmar documentos con el DNIe o un "
"certificado digital. No está en los repositorios de Debian: se descarga de "
"firmaelectronica.gob.es."

