msgid "List PKCS#11 slots"
msgstr "Lister les slots PKCS#11"

#: confusb/kb.py:29
msgid "List certificates"
msgstr "Lister les certificats"

#: confusb/kb.py:34
msgid "pcsc-tools (reader and card monitor)"
msgstr "pcsc-tools (moniteur de lecteurs et de cartes)"

#: confusb/kb.py:35
msgid "pcsc_scan shows in real time when a card is inserted or removed and decodes its ATR."
msgstr "pcsc_scan affiche en temps réel l'insertion ou le retrait d'une carte et décode son ATR."

#: confusb/kb.py:37
msgid "Open pcsc_scan"
msgstr "Ouvrir pcsc_scan"

#: confusb/kb.py:40
msgid "AutoFirma (electronic signature)"
msgstr "AutoFirma (signature électronique)"

