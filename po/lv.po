msgstr "Rādīt PKCS#11 slotus"

#: confusb/kb.py:29
msgid "List certificates"
msgstr "Rādīt sertifikātus"

#: confusb/kb.py:34
msgid "pcsc-tools (reader and card monitor)"
msgstr "pcsc-tools (lasītāju un karšu monitors)"

#: confusb/kb.py:35
msgid ""
"pcsc_scan shows in real time when a card is inserted or removed and decodes "
"its ATR."
