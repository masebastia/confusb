#: confusb/kb.py:17
msgid "PC/SC service and CCID drivers"
msgstr "Serviço PC/SC e controladores CCID"

#: confusb/kb.py:18
msgid ""
"pcscd is the daemon that manages smart card readers; libccid provides the "
"driver for standard USB readers (CCID). Without pcscd the reader shows up in "
"USB but no application can use it."
msgstr ""
"O pcscd é o serviço que gere os leitores de cartões inteligentes; o libccid "
"fornece o controlador para leitores USB padrão (CCID). Sem o pcscd, o leitor "
"aparece em USB mas nenhuma aplicação o consegue usar."

#: confusb/kb.py:22
msgid "OpenSC (PKCS#11, supports DNIe and other cards)"
msgstr "OpenSC (PKCS#11, suporta o DNIe e outros cartões)"

#: confusb/kb.py:23
msgid ""
"Library and tools for cryptographic cards. It includes support for the DNIe "
"(3.0/4.0) and the PKCS#11 module used by Firefox/Chromium and AutoFirma. "
"Older DNIe cards (2.0) may need the official DNIe module."
msgstr ""
"Biblioteca e ferramentas para cartões criptográficos. Inclui suporte para o "
"DNIe (3.0/4.0) e o módulo PKCS#11 usado pelo Firefox/Chromium e pelo "
"AutoFirma. Os DNIe antigos (2.0) podem precisar do módulo oficial do DNIe."

#: confusb/kb.py:26
msgid "List readers"
msgstr "Listar leitores"

#: confusb/kb.py:27
msgid "Card info (ATR)"
msgstr "Informação do cartão (ATR)"

