msgstr "pcsc-tools (nadzor bralnikov in kartic)"

#: confusb/kb.py:35
msgid ""
"pcsc_scan shows in real time when a card is inserted or removed and decodes "
"its ATR."
msgstr ""
"pcsc_scan v realnem času prikazuje vstavitev ali odstranitev kartice in "
"dekodira njen ATR."

#: confusb/kb.py:37
