#: confusb/configuracion.py:318
#, python-brace-format
msgid ""
"It has a manufacturer-specific HID channel ({n} feature or output reports, "
"up to {size} bytes). The software of gaming mice usually uses it for "
"settings such as DPI, buttons and lighting."
msgstr "Ima HID kanal specifičan za proizvođača ({n} izvješća o značajkama ili izlaznih, do {size} bajtova). Softver gaming miševa obično ga koristi za postavke poput DPI-ja, tipki i osvjetljenja."

