#: confusb/cli.py:26
msgid ""
"Shows the information of a USB device when it is connected and looks for its "
"driver and the applications to use it."
msgstr ""
"Muestra la información de un dispositivo USB al conectarlo y busca su "
"controlador y las aplicaciones para usarlo."

#: confusb/cli.py:28
msgid ""
"Without arguments it runs as a service that watches the USB connections "
"according to the settings."
msgstr ""
"Sin argumentos se ejecuta como servicio que vigila las conexiones USB según "
"los ajustes."

#: confusb/cli.py:29
msgid "show the window with the connected devices"
msgstr "mostrar la ventana con los dispositivos conectados"

#: confusb/cli.py:30
msgid "open the details of a device (1-5, VID:PID or sysfs path)"
msgstr "abrir el detalle de un dispositivo (1-5, VID:PID o ruta sysfs)"

#: confusb/cli.py:31
msgid "list the USB devices and exit"
msgstr "listar los dispositivos USB y salir"

#: confusb/cli.py:33
msgid ""
"print all the information of a device and exit (1-5, VID:PID or sysfs path)"
msgstr ""
"imprimir toda la información de un dispositivo y salir (1-5, VID:PID o ruta "
"sysfs)"

#: confusb/cli.py:34
msgid "show the version and exit"
msgstr "mostrar la versión y salir"

