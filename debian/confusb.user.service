[Unit]
Description=confusb - USB device information and drivers
After=graphical-session.target
PartOf=graphical-session.target

[Service]
ExecStart=/usr/bin/confusb
# Las ventanas que lanza el servicio son procesos suyos: reiniciarlo no debe cerrarlas.
KillMode=process
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
