msgstr "Listează sloturile PKCS#11"

#: confusb/kb.py:29
msgid "List certificates"
msgstr "Listează certificatele"

#: confusb/kb.py:34
msgid "pcsc-tools (reader and card monitor)"
msgstr "pcsc-tools (monitor pentru cititoare și carduri)"

#: confusb/kb.py:35
msgid ""
"pcsc_scan shows in real time when a card is inserted or removed and decodes "
"its ATR."
msgstr ""
"pcsc_scan afișează în timp real când un card este introdus sau scos și "
"decodifică ATR-ul său."

#: confusb/kb.py:37
msgid "Open pcsc_scan"
msgstr "Deschide pcsc_scan"

#: confusb/kb.py:40
