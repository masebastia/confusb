#: confusb/kb.py:17
msgid "PC/SC service and CCID drivers"
msgstr "Servizio PC/SC e driver CCID"

#: confusb/kb.py:18
msgid ""
"pcscd is the daemon that manages smart card readers; libccid provides the "
"driver for standard USB readers (CCID). Without pcscd the reader shows up in "
"USB but no application can use it."
msgstr ""
"pcscd è il demone che gestisce i lettori di smart card; libccid fornisce il "
"driver per i lettori USB standard (CCID). Senza pcscd il lettore compare in "
"USB ma nessuna applicazione può usarlo."

#: confusb/kb.py:22
msgid "OpenSC (PKCS#11, supports DNIe and other cards)"
msgstr "OpenSC (PKCS#11, supporta il DNIe e altre carte)"

#: confusb/kb.py:23
msgid ""
"Library and tools for cryptographic cards. It includes support for the DNIe "
"(3.0/4.0) and the PKCS#11 module used by Firefox/Chromium and AutoFirma. "
"Older DNIe cards (2.0) may need the official DNIe module."
msgstr ""
"Libreria e strumenti per le carte crittografiche. Include il supporto per il "
"DNIe (3.0/4.0) e il modulo PKCS#11 usato da Firefox/Chromium e AutoFirma. I "
"DNIe più vecchi (2.0) possono richiedere il modulo ufficiale del DNIe."

#: confusb/kb.py:26
msgid "List readers"
msgstr "Elenca i lettori"

#: confusb/kb.py:27
msgid "Card info (ATR)"
msgstr "Info sulla carta (ATR)"

#: confusb/kb.py:28
msgid "List PKCS#11 slots"
msgstr "Elenca gli slot PKCS#11"

#: confusb/kb.py:29
msgid "List certificates"
msgstr "Elenca i certificati"

#: confusb/kb.py:34
msgid "pcsc-tools (reader and card monitor)"
msgstr "pcsc-tools (monitor di lettori e carte)"

#: confusb/kb.py:35
msgid ""
"pcsc_scan shows in real time when a card is inserted or removed and decodes "
"its ATR."
msgstr ""
"pcsc_scan mostra in tempo reale quando una carta viene inserita o rimossa e "
"ne decodifica l'ATR."

#: confusb/kb.py:37
msgid "Open pcsc_scan"
msgstr "Apri pcsc_scan"

#: confusb/kb.py:40
msgid "AutoFirma (electronic signature)"
msgstr "AutoFirma (firma elettronica)"

#: confusb/kb.py:41
msgid ""
"Official Spanish Government application to sign documents with the DNIe or a "
"digital certificate. It is not in the Debian repositories: it is downloaded "
"from firmaelectronica.gob.es."
msgstr ""
"Applicazione ufficiale del governo spagnolo per firmare documenti con il "
"DNIe o un certificato digitale. Non è nei repository Debian: si scarica da "
"firmaelectronica.gob.es."

