#: confusb/componentes.py:591
msgid ""
"Notifies when a USB device is connected, shows its information and looks for "
"its driver and the applications to use it."
msgstr ""
"Jinnotifika meta jiġi konness apparat USB, juri l-informazzjoni tiegħu u "
"jfittex id-driver tiegħu u l-applikazzjonijiet biex jintuża."

